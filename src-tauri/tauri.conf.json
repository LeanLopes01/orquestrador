{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Jarvis",
  "version": "0.3.0",
  "identifier": "local.dicevtt.orquestrador",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build && node scripts/prepare-desktop.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "J.A.R.V.I.S. — Central pessoal",
        "width": 1440,
        "height": 960,
        "minWidth": 900,
        "minHeight": 650
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "resources": {
      "runtime/": "runtime/"
    },
    "icon": [
      "icons/icon.ico"
    ]
  }
}